{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "ignorePatterns": [
    "src/generated/**",
    "export/**",
    "dist/**"
  ],
  "overrides": [
    {
      "files": [
        "src/core/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-*",
                  "zustand",
                  "motion",
                  "motion/*",
                  "zod",
                  "sharp",
                  "node:*",
                  "**/ui/**",
                  "**/state/**",
                  "**/sim/**",
                  "**/content/**"
                ],
                "message": "src/core saf oyun motorudur (Unity'ye C# olarak taşınır): yalnızca src/core içinden import edebilir."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/sim/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-*",
                  "zustand",
                  "motion",
                  "motion/*",
                  "sharp",
                  "node:*",
                  "**/ui/**",
                  "**/state/**"
                ],
                "message": "src/sim saf TS'dir (Node CLI ve tarayıcı Web Worker'da çalışır): UI/Node API kullanmaz."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/**/*.test.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
