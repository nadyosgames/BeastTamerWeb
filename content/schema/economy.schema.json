{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "rarities": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "common",
          "uncommon",
          "rare",
          "epic",
          "legendary",
          "mythic",
          "ancient"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "deckLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "duplicatePct": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "deckLimit",
          "duplicatePct"
        ],
        "additionalProperties": false
      },
      "required": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary",
        "mythic",
        "ancient"
      ]
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "priceMult": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cards": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "odds": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "common",
                "uncommon",
                "rare",
                "epic",
                "legendary",
                "mythic",
                "ancient"
              ]
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "guarantee": {
            "type": "object",
            "properties": {
              "rarityAtLeast": {
                "type": "string",
                "enum": [
                  "common",
                  "uncommon",
                  "rare",
                  "epic",
                  "legendary",
                  "mythic",
                  "ancient"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "rarityAtLeast",
              "count"
            ],
            "additionalProperties": false
          },
          "element": {
            "type": "boolean"
          },
          "smart": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "priceMult",
          "cards",
          "odds"
        ],
        "additionalProperties": false
      }
    },
    "packBasePrice": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "basePack": {
      "type": "string"
    },
    "pity": {
      "type": "object",
      "properties": {
        "packsWithoutRarePlus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "packsWithoutRarePlus"
      ],
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "planningSecPerRound": {
          "type": "number"
        },
        "secPerStep": {
          "type": "number"
        }
      },
      "required": [
        "planningSecPerRound",
        "secPerStep"
      ],
      "additionalProperties": false
    },
    "expedition": {
      "type": "object",
      "properties": {
        "rations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "restHealPct": {
          "type": "number",
          "minimum": 0
        },
        "speedBonusPct": {
          "type": "number",
          "minimum": 0
        },
        "streakBonusPct": {
          "type": "number",
          "minimum": 0
        },
        "bagLossPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "woundCarryPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "siegeNightHealPct": {
          "type": "number",
          "minimum": 0
        },
        "essenceByRarity": {
          "type": "object",
          "properties": {
            "common": {
              "type": "number",
              "minimum": 0
            },
            "uncommon": {
              "type": "number",
              "minimum": 0
            },
            "rare": {
              "type": "number",
              "minimum": 0
            },
            "epic": {
              "type": "number",
              "minimum": 0
            },
            "legendary": {
              "type": "number",
              "minimum": 0
            },
            "mythic": {
              "type": "number",
              "minimum": 0
            },
            "ancient": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "common",
            "uncommon",
            "rare",
            "epic",
            "legendary",
            "mythic",
            "ancient"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "rations",
        "restHealPct",
        "speedBonusPct",
        "streakBonusPct",
        "bagLossPct",
        "woundCarryPct",
        "siegeNightHealPct",
        "essenceByRarity"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "rarities",
    "packs",
    "packBasePrice",
    "basePack",
    "pity",
    "timing",
    "expedition"
  ],
  "additionalProperties": false
}
