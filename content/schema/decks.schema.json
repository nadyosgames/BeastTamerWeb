{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "decks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "tamer": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "card": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "card",
                "count"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "tamer",
          "text",
          "cards"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "decks"
  ],
  "additionalProperties": false
}
