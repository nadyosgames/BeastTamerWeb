# İsteğe bağlı: `npm run art:generate` ile OpenAI Images API üzerinden toplu görsel üretimi.
# Bu dosyayı .env olarak kopyala ve anahtarını yaz (.env git'e girmez).
OPENAI_API_KEY=
# Varsayılan model; hesabındaki güncel görsel modelin adıyla değiştirebilirsin.
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high
